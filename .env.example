SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# ID kênh duy nhất bot được trả lời. Mở chi tiết kênh và copy Channel ID.
SLACK_CHANNEL=C0123456789

# Khóa HMAC cho POST /ingest/quotes. Khóa không gửi lên mạng.
# Ngoài máy local: đặt khóa trong secret store, dài ít nhất 32 ký tự, và gọi API qua HTTPS.
INGEST_URL=http://127.0.0.1:8080
INGEST_KEY=local-dev-only-market-brief-ingest-key

# MySQL local từ docker compose. Mật khẩu này chỉ dùng trên máy. API đọc và ghi database này.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=market_brief
MYSQL_PASSWORD=market_brief
MYSQL_DATABASE=market_brief
MYSQL_ROOT_PASSWORD=market_brief_root
